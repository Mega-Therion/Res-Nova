namespace ResNova.OctonionHopfShells

/-- Explicit real octonion `x = x₀ + x₁ e₁ + x₂ e₂ + x₃ e₃ + x₄ e₄ + x₅ e₅ + x₆ e₆ + x₇ e₇`. -/
@[ext]
structure Oct where
  x0 : ℝ
  x1 : ℝ
  x2 : ℝ
  x3 : ℝ
  x4 : ℝ
  x5 : ℝ
  x6 : ℝ
  x7 : ℝ

namespace Oct

def zero : Oct := ⟨0, 0, 0, 0, 0, 0, 0, 0⟩
def one  : Oct := ⟨1, 0, 0, 0, 0, 0, 0, 0⟩
def e1   : Oct := ⟨0, 1, 0, 0, 0, 0, 0, 0⟩
def e2   : Oct := ⟨0, 0, 1, 0, 0, 0, 0, 0⟩
def e3   : Oct := ⟨0, 0, 0, 1, 0, 0, 0, 0⟩
def e4   : Oct := ⟨0, 0, 0, 0, 1, 0, 0, 0⟩
def e5   : Oct := ⟨0, 0, 0, 0, 0, 1, 0, 0⟩
def e6   : Oct := ⟨0, 0, 0, 0, 0, 0, 1, 0⟩
def e7   : Oct := ⟨0, 0, 0, 0, 0, 0, 0, 1⟩

def add (x y : Oct) : Oct :=
  ⟨x.x0 + y.x0, x.x1 + y.x1, x.x2 + y.x2, x.x3 + y.x3,
   x.x4 + y.x4, x.x5 + y.x5, x.x6 + y.x6, x.x7 + y.x7⟩

def neg (x : Oct) : Oct :=
  ⟨-x.x0, -x.x1, -x.x2, -x.x3, -x.x4, -x.x5, -x.x6, -x.x7⟩

def smul (c : ℝ) (x : Oct) : Oct :=
  ⟨c * x.x0, c * x.x1, c * x.x2, c * x.x3,
   c * x.x4, c * x.x5, c * x.x6, c * x.x7⟩

def conj (x : Oct) : Oct :=
  ⟨x.x0, -x.x1, -x.x2, -x.x3, -x.x4, -x.x5, -x.x6, -x.x7⟩

/-- Euclidean inner product on `𝕆 ≅ ℝ⁸`. -/
def dot (x y : Oct) : ℝ :=
  x.x0 * y.x0 + x.x1 * y.x1 + x.x2 * y.x2 + x.x3 * y.x3 +
  x.x4 * y.x4 + x.x5 * y.x5 + x.x6 * y.x6 + x.x7 * y.x7

/-- Squared Euclidean / octonion norm `‖x‖²`. -/
def normSq (x : Oct) : ℝ := dot x x

/-- Octonion multiplication defined by the oriented Fano triples
`(1,2,3), (1,4,5), (1,6,7), (2,4,7), (2,5,6), (3,4,6), (3,7,5)`. -/
def mul (x y : Oct) : Oct :=
  { x0 := x.x0 * y.x0 - x.x1 * y.x1 - x.x2 * y.x2 - x.x3 * y.x3 - x.x4 * y.x4 - x.x5 * y.x5 - x.x6 * y.x6 - x.x7 * y.x7
  , x1 := x.x0 * y.x1 + x.x1 * y.x0 + x.x2 * y.x3 - x.x3 * y.x2 + x.x4 * y.x5 - x.x5 * y.x4 + x.x6 * y.x7 - x.x7 * y.x6
  , x2 := x.x0 * y.x2 - x.x1 * y.x3 + x.x2 * y.x0 + x.x3 * y.x1 + x.x4 * y.x7 + x.x5 * y.x6 - x.x6 * y.x5 - x.x7 * y.x4
  , x3 := x.x0 * y.x3 + x.x1 * y.x2 - x.x2 * y.x1 + x.x3 * y.x0 + x.x4 * y.x6 - x.x5 * y.x7 - x.x6 * y.x4 + x.x7 * y.x5
  , x4 := x.x0 * y.x4 - x.x1 * y.x5 - x.x2 * y.x7 - x.x3 * y.x6 + x.x4 * y.x0 + x.x5 * y.x1 + x.x6 * y.x3 + x.x7 * y.x2
  , x5 := x.x0 * y.x5 + x.x1 * y.x4 - x.x2 * y.x6 + x.x3 * y.x7 - x.x4 * y.x1 + x.x5 * y.x0 + x.x6 * y.x2 - x.x7 * y.x3
  , x6 := x.x0 * y.x6 - x.x1 * y.x7 + x.x2 * y.x5 + x.x3 * y.x4 - x.x4 * y.x3 - x.x5 * y.x2 + x.x6 * y.x0 + x.x7 * y.x1
  , x7 := x.x0 * y.x7 + x.x1 * y.x6 + x.x2 * y.x4 - x.x3 * y.x5 - x.x4 * y.x2 + x.x5 * y.x3 - x.x6 * y.x1 + x.x7 * y.x0
  }

instance : Zero Oct := ⟨zero⟩
instance : One Oct := ⟨one⟩
instance : Add Oct := ⟨add⟩
instance : Neg Oct := ⟨neg⟩
instance : Mul Oct := ⟨mul⟩
instance : SMul ℝ Oct := ⟨smul⟩

@[simp] lemma mul_def (x y : Oct) : x * y = mul x y := rfl
@[simp] lemma add_def (x y : Oct) : x + y = add x y := rfl
@[simp] lemma neg_def (x : Oct) : -x = neg x := rfl
@[simp] lemma smul_def (c : ℝ) (x : Oct) : c • x = smul c x := rfl

/-! ## 1. Composition Norm & Alternativity / Complex Structure (`BLK-1408`) -/

/-- Degen–Graves 8-square composition identity: `‖x * y‖² = ‖x‖² * ‖y‖²`. -/
theorem normSq_mul (x y : Oct) : normSq (x * y) = normSq x * normSq y := by
  dsimp only [normSq, dot, mul_def, mul]
  ring

/-- Left multiplication by any purely imaginary octonion `u` (`u.x0 = 0`) satisfies
`u * (u * x) = -‖u‖² • x` (left alternativity on `Im(𝕆)`). -/
theorem leftMul_sq_imag (u x : Oct) (hu : u.x0 = 0) :
    u * (u * x) = (-normSq u) • x := by
  ext <;> { dsimp only [mul_def, smul_def, mul, smul, normSq, dot]; rw [hu]; ring }

/-- For any unit imaginary octonion `u ∈ S⁶ ⊂ Im(𝕆)`, `J_u(x) = u * x` satisfies `J_u(J_u(x)) = -x`. -/
theorem leftMul_sq_unit_imag (u x : Oct) (hu : u.x0 = 0) (hunorm : normSq u = 1) :
    u * (u * x) = -x := by
  rw [leftMul_sq_imag u x hu, hunorm]
  ext <;> { dsimp only [smul_def, neg_def, smul, neg]; ring }

/-- Left multiplication by any unit octonion preserves the Euclidean norm (`J_u` is an isometry). -/
theorem normSq_leftMul_unit (u x : Oct) (hunorm : normSq u = 1) :
    normSq (u * x) = normSq x := by
  rw [normSq_mul, hunorm, one_mul]

/-- Left multiplication by any imaginary octonion is skew-symmetric: `⟨u * x, x⟩ = 0`. -/
theorem dot_leftMul_imag_self (u x : Oct) (hu : u.x0 = 0) :
    dot (u * x) x = 0 := by
  dsimp only [dot, mul_def, mul]
  rw [hu]
  ring

/-! ## 2. Explicit Complex-Hopf Isometry `Φ : ℂ⁴ → 𝕆` and `U(1)` Equivariance (`BLK-1408`) -/

/-- The `J_{e₁}`-adapted real-linear map `Φ : ℂ⁴ → 𝕆` sending
`(a₀ + i b₀, a₁ + i b₁, a₂ + i b₂, a₃ + i b₃)` to
`a₀ 1 + b₀ e₁ + a₁ e₂ + b₁ e₃ + a₂ e₄ + b₂ e₅ + a₃ e₆ + b₃ e₇`,
where `e₃ = e₁ e₂`, `e₅ = e₁ e₄`, `e₇ = e₁ e₆`. -/
def Phi (a0 b0 a1 b1 a2 b2 a3 b3 : ℝ) : Oct :=
  ⟨a0, b0, a1, b1, a2, b2, a3, b3⟩

/-- `Φ` preserves the norm exactly, restricting to an isometry `S⁷(ℂ⁴) → S⁷(𝕆)`. -/
theorem Phi_normSq (a0 b0 a1 b1 a2 b2 a3 b3 : ℝ) :
    normSq (Phi a0 b0 a1 b1 a2 b2 a3 b3) =
      (a0 ^ 2 + b0 ^ 2) + (a1 ^ 2 + b1 ^ 2) + (a2 ^ 2 + b2 ^ 2) + (a3 ^ 2 + b3 ^ 2) := by
  unfold normSq dot Phi
  ring

/-- The unit circle element `exp(θ e₁) = c · 1 + s · e₁` in `ℂ_{e₁} ⊂ 𝕆` (`c = cos θ, s = sin θ`). -/
def expE1 (c s : ℝ) : Oct := ⟨c, s, 0, 0, 0, 0, 0, 0⟩

/-- `exp(θ e₁)` lies on the unit sphere `S⁷ ⊂ 𝕆` whenever `c² + s² = 1`. -/
theorem normSq_expE1 (c s : ℝ) (hcs : c ^ 2 + s ^ 2 = 1) : normSq (expE1 c s) = 1 := by
  unfold normSq dot expE1
  linarith

/-- `Φ` intertwines the standard `U(1)` Hopf action `zₖ ↦ (c + i s) zₖ` on `ℂ⁴`
with left octonion multiplication by `exp(θ e₁) = c · 1 + s · e₁`. -/
theorem Phi_hopf_equivariant (c s a0 b0 a1 b1 a2 b2 a3 b3 : ℝ) :
    Phi (a0 * c - b0 * s) (a0 * s + b0 * c)
        (a1 * c - b1 * s) (a1 * s + b1 * c)
        (a2 * c - b2 * s) (a2 * s + b2 * c)
        (a3 * c - b3 * s) (a3 * s + b3 * c) =
      expE1 c s * Phi a0 b0 a1 b1 a2 b2 a3 b3 := by
  ext <;> { dsimp only [mul_def, Phi, expE1, mul]; ring }

/-! ## 3. The `ℂℙ²` Family of Associative Quaternionic `S³` Shells (`BLK-1411`) -/

/-- A vector `v ∈ 𝕆` belongs to the 6D real / 3D complex subspace `E = ℂ_{e₁}⊥ ∩ Im(𝕆)`
iff `v.x0 = 0` and `v.x1 = 0`. -/
def MemE (v : Oct) : Prop := v.x0 = 0 ∧ v.x1 = 0

/-- `E` is invariant under `J = L_{e₁}`: if `v ∈ E`, then `e₁ * v ∈ E`. -/
theorem e1_mul_mem_E (v : Oct) (hv : MemE v) : MemE (e1 * v) := by
  rcases hv with ⟨h0, h1⟩
  constructor <;> { dsimp only [mul_def, e1, mul]; rw [h0, h1]; ring }

/-- For every `v ∈ E`, `e₁ * v` is orthogonal to `v`. -/
theorem dot_v_e1_mul_v (v : Oct) (hv : MemE v) : dot v (e1 * v) = 0 := by
  rcases hv with ⟨h0, h1⟩
  dsimp only [dot, e1, mul_def, mul]
  rw [h0, h1]
  ring

/-- For every `v ∈ E`, `‖e₁ * v‖² = ‖v‖²`. -/
theorem normSq_e1_mul_v (v : Oct) : normSq (e1 * v) = normSq v := by
  have he1 : normSq e1 = 1 := by unfold normSq dot e1; ring
  exact normSq_leftMul_unit e1 v he1

/-- Hamilton quaternion table on `H(e₁, v) = span_ℝ{1, e₁, v, e₁ * v}` for arbitrary `v ∈ E`:
`v * e₁ = -(e₁ * v)`. -/
theorem v_mul_e1 (v : Oct) (hv : MemE v) : v * e1 = -(e1 * v) := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, neg_def, e1, mul, neg]; rw [h0, h1]; ring }

/-- For `v ∈ E`, `v * v = (-‖v‖²) • 1`. -/
theorem v_mul_v (v : Oct) (hv : MemE v) : v * v = (-normSq v) • one := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, smul_def, one, mul, smul, normSq, dot]; rw [h0, h1]; ring }

/-- For `v ∈ E`, `(e₁ * v) * (e₁ * v) = (-‖v‖²) • 1`. -/
theorem e1v_mul_e1v (v : Oct) (hv : MemE v) : (e1 * v) * (e1 * v) = (-normSq v) • one := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, smul_def, one, e1, mul, smul, normSq, dot]; rw [h0, h1]; ring }

/-- For `v ∈ E`, `e₁ * (e₁ * v) = -v`. -/
theorem e1_mul_e1v (v : Oct) : e1 * (e1 * v) = -v := by
  have h0 : e1.x0 = 0 := rfl
  have hn : normSq e1 = 1 := by unfold normSq dot e1; ring
  exact leftMul_sq_unit_imag e1 v h0 hn

/-- For `v ∈ E`, `(e₁ * v) * e₁ = v`. -/
theorem e1v_mul_e1 (v : Oct) (hv : MemE v) : (e1 * v) * e1 = v := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, e1, mul]; rw [h0, h1]; ring }

/-- For `v ∈ E`, `v * (e₁ * v) = ‖v‖² • e₁`. -/
theorem v_mul_e1v (v : Oct) (hv : MemE v) : v * (e1 * v) = (normSq v) • e1 := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, smul_def, e1, mul, smul, normSq, dot]; rw [h0, h1]; ring }

/-- For `v ∈ E`, `(e₁ * v) * v = (-‖v‖²) • e₁`. -/
theorem e1v_mul_v (v : Oct) (hv : MemE v) : (e1 * v) * v = (-normSq v) • e1 := by
  rcases hv with ⟨h0, h1⟩
  ext <;> { dsimp only [mul_def, smul_def, e1, mul, smul, normSq, dot]; rw [h0, h1]; ring }

/-- Parameterization of the 4D quaternion subalgebra `H(e₁, v) = span_ℝ{1, e₁, v, e₁ * v}`
associated to any `v ∈ E`. -/
def quatShellElem (v : Oct) (c0 c1 c2 c3 : ℝ) : Oct :=
  c0 • one + c1 • e1 + c2 • v + c3 • (e1 * v)

/-- Norm on `H(e₁, v)`: for any unit `v ∈ E` (`‖v‖² = 1`), `{1, e₁, v, e₁ * v}` is orthonormal,
so `‖quatShellElem v c₀ c₁ c₂ c₃‖² = c₀² + c₁² + c₂² + c₃²`, identifying `H(e₁, v) ∩ S⁷`
isometrically with the unit round `S³`. -/
theorem normSq_quatShellElem (v : Oct) (hv : MemE v) (hvnorm : normSq v = 1)
    (c0 c1 c2 c3 : ℝ) :
    normSq (quatShellElem v c0 c1 c2 c3) = c0 ^ 2 + c1 ^ 2 + c2 ^ 2 + c3 ^ 2 := by
  rcases hv with ⟨h0, h1⟩
  have hvn : v.x2 ^ 2 + v.x3 ^ 2 + v.x4 ^ 2 + v.x5 ^ 2 + v.x6 ^ 2 + v.x7 ^ 2 = 1 := by
    unfold normSq dot at hvnorm
    linarith [show v.x0 ^ 2 = 0 by nlinarith, show v.x1 ^ 2 = 0 by nlinarith]
  dsimp only [normSq, dot, quatShellElem, add_def, smul_def, mul_def, add, smul, one, e1, mul]
  rw [h0, h1]
  linear_combination (c2 ^ 2 + c3 ^ 2) * hvn

/-- **Explicit Quaternion Multiplication Law on `H(e₁, v)` (`BLK-1411`):**
For every `v ∈ E`, the 4D subspace `H(e₁, v) = span_ℝ{1, e₁, v, e₁ * v}` is closed under
octonion multiplication and obeys the exact quaternion product formula weighted by `‖v‖²`. -/
theorem quatShellElem_mul (v : Oct) (hv : MemE v)
    (p0 p1 p2 p3 q0 q1 q2 q3 : ℝ) :
    quatShellElem v p0 p1 p2 p3 * quatShellElem v q0 q1 q2 q3 =
      quatShellElem v
        (p0 * q0 - p1 * q1 - (p2 * q2 + p3 * q3) * normSq v)
        (p0 * q1 + p1 * q0 + (p2 * q3 - p3 * q2) * normSq v)
        (p0 * q2 - p1 * q3 + p2 * q0 + p3 * q1)
        (p0 * q3 + p1 * q2 - p2 * q1 + p3 * q0) := by
  rcases hv with ⟨h0, h1⟩
  ext <;> {
    dsimp only [quatShellElem, add_def, smul_def, mul_def, add, smul, one, e1, mul, normSq, dot]
    rw [h0, h1]
    ring
  }

/-- **Full Associativity of `H(e₁, v)` (`BLK-1411`):**
For every `v ∈ E`, the 4D subspace `H(e₁, v) = span_ℝ{1, e₁, v, e₁ * v}` is an associative
subalgebra of `𝕆`: `(p * q) * r = p * (q * r)` for all `p, q, r ∈ H(e₁, v)`. -/
theorem quatShell_mul_assoc (v : Oct) (hv : MemE v)
    (p0 p1 p2 p3 q0 q1 q2 q3 r0 r1 r2 r3 : ℝ) :
    (quatShellElem v p0 p1 p2 p3 * quatShellElem v q0 q1 q2 q3) * quatShellElem v r0 r1 r2 r3 =
      quatShellElem v p0 p1 p2 p3 * (quatShellElem v q0 q1 q2 q3 * quatShellElem v r0 r1 r2 r3) := by
  rw [quatShellElem_mul v hv p0 p1 p2 p3 q0 q1 q2 q3,
      quatShellElem_mul v hv _ _ _ _ r0 r1 r2 r3,
      quatShellElem_mul v hv q0 q1 q2 q3 r0 r1 r2 r3,
      quatShellElem_mul v hv p0 p1 p2 p3 _ _ _ _]
  congr 1 <;> ring

/-! ## 4. The `ℤ₃ ⊂ SU(3) = Stab_{G₂}(e₁)` Generation Automorphism `τ` and Diagonal Shell Selection -/

/-- The order-3 cyclic permutation `τ` of the three Fano complex lines
`L₁ = span{e₂, e₃} → L₂ = span{e₄, e₅} → L₃ = span{e₆, e₇} → L₁`, fixing `1` and `e₁`. -/
def tau (x : Oct) : Oct :=
  ⟨x.x0, x.x1, x.x6, x.x7, x.x2, x.x3, x.x4, x.x5⟩

/-- `τ` is an algebra automorphism of `𝕆` (`τ ∈ Aut(𝕆) = G₂`). -/
theorem tau_mul (x y : Oct) : tau (x * y) = tau x * tau y := by
  ext <;> { dsimp only [mul_def, tau, mul]; ring }

/-- `τ` fixes `1` and `e₁`, so `τ ∈ Stab_{G₂}(e₁) = SU(3)`. -/
theorem tau_fixes_one : tau one = one := by
  ext <;> rfl

theorem tau_fixes_e1 : tau e1 = e1 := by
  ext <;> rfl

/-- `τ` has exact order 3 (`τ³ = id`). -/
theorem tau_cubed (x : Oct) : tau (tau (tau x)) = x := by
  ext <;> rfl

/-- `τ` is an orthogonal isometry (`‖τ(x)‖² = ‖x‖²`). -/
theorem normSq_tau (x : Oct) : normSq (tau x) = normSq x := by
  unfold normSq dot tau
  ring

/-- `τ` cycles the three torus-fixed Fano basis vectors `e₂ → e₄ → e₆ → e₂` and `e₃ → e₅ → e₇ → e₃`. -/
theorem tau_cycles_fano_lines :
    tau e2 = e4 ∧ tau e4 = e6 ∧ tau e6 = e2 ∧
    tau e3 = e5 ∧ tau e5 = e7 ∧ tau e7 = e3 := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (ext <;> rfl)

/-- The canonical diagonal generator `v_diag = e₂ + e₄ + e₆ ∈ E`. -/
def vDiag : Oct := ⟨0, 0, 1, 0, 1, 0, 1, 0⟩

theorem vDiag_mem_E : MemE vDiag := ⟨rfl, rfl⟩

/-- **Exact Characterization of the `τ`-Fixed Subalgebra `𝕆^τ`:**
An octonion `x ∈ 𝕆` is fixed by `τ ∈ SU(3) ⊂ G₂` iff `x ∈ H(e₁, v_diag)`.
Thus the `ℤ₃` Fano-line permutation symmetry selects a unique pointwise-fixed quaternion
subalgebra `𝕆^τ = H(e₁, v_diag)` (and a unique fixed complex line `L_diag = ℂ_{e₁} v_diag ∈ ℂℙ²`). -/
theorem tau_fixed_iff (x : Oct) :
    tau x = x ↔ ∃ c0 c1 c2 c3 : ℝ, x = quatShellElem vDiag c0 c1 c2 c3 := by
  constructor
  · intro h
    have h2 : x.x6 = x.x2 := congrArg Oct.x2 h
    have h3 : x.x7 = x.x3 := congrArg Oct.x3 h
    have h4 : x.x2 = x.x4 := congrArg Oct.x4 h
    have h5 : x.x3 = x.x5 := congrArg Oct.x5 h
    refine ⟨x.x0, x.x1, x.x2, x.x3, ?_⟩
    ext <;> { dsimp only [quatShellElem, vDiag, add_def, smul_def, mul_def, add, smul, one, e1, mul]; try linarith }
  · rintro ⟨c0, c1, c2, c3, rfl⟩
    ext <;> { dsimp only [tau, quatShellElem, vDiag, add_def, smul_def, mul_def, add, smul, one, e1, mul]; try ring }

end Oct

end ResNova.OctonionHopfShells

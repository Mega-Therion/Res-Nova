/-
Copyright (c) 2026 R.W. Yett. Released under Apache 2.0.

Countable basis of finite binary prefixes.

Each rung is a finite list of bits. `le` is the prefix order.
`encode` / `decode` are a bijection with Nat, so the set of rungs is countable.

The ideal completion is the type Shade: a finite rung, or one infinite bit-stream.
Membership in each shade is proved to be a nonempty, downward-closed, directed set.
Every such set is equal to exactly one of those two forms. The stream case uses
Classical.choice to pick a rung long enough to read each bit.

The Scott topology is generated by the basic opens `above p`: the shades that contain
the finite rung `p`. Each is an upper set, and a directed supremum lies in one only
when some member of the family already does. No physical coordinate is defined here.
-/

namespace ResNova.Foundations.BinaryPrefixBasis

inductive Pref where
  | nil
  | cons (bit : Bool) (rest : Pref)
  deriving DecidableEq

def le : Pref → Pref → Prop
  | .nil, _ => True
  | .cons _ _, .nil => False
  | .cons b t, .cons c u => b = c ∧ le t u

theorem le_refl (p : Pref) : le p p := by
  induction p with
  | nil => trivial
  | cons _ _ ih =>
      exact ⟨rfl, ih⟩

theorem le_trans {p q r : Pref} (hpq : le p q) (hqr : le q r) : le p r := by
  induction p generalizing q r with
  | nil => trivial
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at hpq
      | cons c u =>
          cases r with
          | nil =>
              simp [le] at hqr
          | cons d v =>
              rcases hpq with ⟨rfl, ht⟩
              rcases hqr with ⟨rfl, hu⟩
              exact ⟨rfl, ih ht hu⟩

theorem le_antisymm {p q : Pref} (hpq : le p q) (hqp : le q p) : p = q := by
  induction p generalizing q with
  | nil =>
      cases q with
      | nil => rfl
      | cons _ _ =>
          simp [le] at hqp
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at hpq
      | cons c u =>
          rcases hpq with ⟨rfl, ht⟩
          rcases hqp with ⟨_, hu⟩
          exact congrArg (Pref.cons b) (ih ht hu)

theorem le_nil (p : Pref) : le .nil p := trivial

theorem nil_le_cons_false {b : Bool} {t : Pref} : ¬ le (.cons b t) .nil := by
  simp [le]

/-- A common extension forces the two rungs onto one chain. -/
theorem le_total_of_common_bound {p q r : Pref} (hp : le p r) (hq : le q r) :
    le p q ∨ le q p := by
  induction p generalizing q r with
  | nil =>
      exact Or.inl (le_nil q)
  | cons b t ih =>
      cases q with
      | nil =>
          exact Or.inr (le_nil _)
      | cons c u =>
          cases r with
          | nil =>
              simp [le] at hp
          | cons d v =>
              rcases hp with ⟨rfl, ht⟩
              rcases hq with ⟨rfl, hu⟩
              cases ih ht hu with
              | inl h => exact Or.inl ⟨rfl, h⟩
              | inr h => exact Or.inr ⟨rfl, h⟩

def join : Pref → Pref → Pref
  | .nil, q => q
  | p, .nil => p
  | .cons b t, .cons _ u => .cons b (join t u)

theorem join_eq_right_of_le {p q : Pref} (h : le p q) : join p q = q := by
  induction p generalizing q with
  | nil => rfl
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at h
      | cons c u =>
          rcases h with ⟨rfl, ht⟩
          simp [join, ih ht]

theorem join_eq_left_of_le {p q : Pref} (h : le q p) : join p q = p := by
  induction p generalizing q with
  | nil =>
      cases q with
      | nil => rfl
      | cons _ _ =>
          simp [le] at h
  | cons b t ih =>
      cases q with
      | nil => rfl
      | cons c u =>
          rcases h with ⟨rfl, ht⟩
          simp [join, ih ht]

/-- When both rungs sit under `r`, their join is the longer one and still sits under `r`. -/
theorem join_le_of_common_bound {p q r : Pref} (hp : le p r) (hq : le q r) :
    le (join p q) r := by
  cases le_total_of_common_bound hp hq with
  | inl h =>
      rw [join_eq_right_of_le h]
      exact hq
  | inr h =>
      rw [join_eq_left_of_le h]
      exact hp

/-! ### Enumeration -/

def encode : Pref → Nat
  | .nil => 0
  | .cons false t => 2 * encode t + 1
  | .cons true t => 2 * encode t + 2

def decode : Nat → Pref
  | 0 => .nil
  | n + 1 =>
      if (n + 1) % 2 = 1 then
        .cons false (decode ((n + 1) / 2))
      else
        .cons true (decode ((n + 1) / 2 - 1))

private theorem two_mul_add_one_odd (k : Nat) : (2 * k + 1) % 2 = 1 := by
  induction k with
  | zero => rfl
  | succ k ih =>
      have : 2 * (k + 1) + 1 = (2 * k + 1) + 2 := by omega
      rw [this]
      -- (m + 2) % 2 = m % 2
      have h2 : (2 * k + 1 + 2) % 2 = (2 * k + 1) % 2 := by
        simp [Nat.add_mod_right]
      rw [h2, ih]

private theorem two_mul_add_two_even (k : Nat) : (2 * k + 2) % 2 = 0 := by
  have : 2 * k + 2 = 2 * (k + 1) := by omega
  rw [this]
  exact Nat.mul_mod_right 2 (k + 1)

private theorem div_two_mul_add_one (k : Nat) : (2 * k + 1) / 2 = k := by
  omega

private theorem div_two_mul_add_two (k : Nat) : (2 * k + 2) / 2 = k + 1 := by
  omega

private theorem sub_one_div (k : Nat) : (2 * k + 2) / 2 - 1 = k := by
  rw [div_two_mul_add_two]
  omega

theorem decode_encode (p : Pref) : decode (encode p) = p := by
  induction p with
  | nil => simp [encode, decode]
  | cons b t ih =>
      cases b with
      | false =>
          have henc : encode (.cons false t) = 2 * encode t + 1 := rfl
          rw [henc]
          have hpos : 2 * encode t + 1 = (2 * encode t) + 1 := rfl
          -- decode (m+1) with m = 2k
          have hodd := two_mul_add_one_odd (encode t)
          simp [decode, hodd, div_two_mul_add_one, ih]
      | true =>
          have henc : encode (.cons true t) = 2 * encode t + 2 := rfl
          rw [henc]
          have heven := two_mul_add_two_even (encode t)
          have hne : 2 * encode t + 2 ≠ 0 := by omega
          simp [decode, heven, sub_one_div, ih]

theorem encode_decode (n : Nat) : encode (decode n) = n := by
  induction n using Nat.strongRecOn with
  | ind n ih =>
      cases n with
      | zero => simp [encode, decode]
      | succ m =>
          by_cases hodd : (m + 1) % 2 = 1
          · have hdiv : (m + 1) / 2 < m + 1 := by omega
            have ihd := ih ((m + 1) / 2) hdiv
            simp [decode, hodd, encode, ihd]
            omega
          · have heven : (m + 1) % 2 = 0 := by
              have hlt : (m + 1) % 2 < 2 := Nat.mod_lt _ (by decide)
              omega
            have hpos : 0 < m + 1 := by omega
            have hdiv : (m + 1) / 2 - 1 < m + 1 := by omega
            have ihd := ih ((m + 1) / 2 - 1) hdiv
            simp [decode, heven, encode, ihd]
            omega

theorem encode_injective {p q : Pref} (h : encode p = encode q) : p = q := by
  calc
    p = decode (encode p) := (decode_encode p).symm
    _ = decode (encode q) := by rw [h]
    _ = q := decode_encode q

/-! ### Ideal completion -/

def length : Pref → Nat
  | .nil => 0
  | .cons _ t => Nat.succ (length t)

def get? : Pref → Nat → Option Bool
  | .nil, _ => none
  | .cons b _, 0 => some b
  | .cons _ t, n + 1 => get? t n

theorem length_pos_of_cons {b : Bool} {t : Pref} : 0 < length (.cons b t) := by
  simp [length]

theorem get?_le {p q : Pref} (h : le p q) {i : Nat} (hi : i < length p) :
    get? p i = get? q i := by
  induction p generalizing q i with
  | nil =>
      simp [length] at hi
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at h
      | cons c u =>
          rcases h with ⟨rfl, ht⟩
          cases i with
          | zero => rfl
          | succ i =>
              simp [length] at hi
              exact ih ht hi

theorem le_of_get? {p q : Pref}
    (h : ∀ i, i < length p → get? p i = get? q i) : le p q := by
  induction p generalizing q with
  | nil => exact le_nil q
  | cons b t ih =>
      cases q with
      | nil =>
          have := h 0 length_pos_of_cons
          simp [get?] at this
      | cons c u =>
          have h0 := h 0 length_pos_of_cons
          simp [get?] at h0
          subst h0
          refine ⟨rfl, ih ?_⟩
          intro i hi
          have := h (i + 1) (by simp [length]; omega)
          simpa [get?] using this

def take (n : Nat) (s : Nat → Bool) : Pref :=
  match n with
  | 0 => .nil
  | n + 1 => .cons (s 0) (take n (fun i => s (i + 1)))

theorem length_take (n : Nat) (s : Nat → Bool) : length (take n s) = n := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
      simp [take, length, ih]

theorem get?_take (s : Nat → Bool) {n i : Nat} (hi : i < n) :
    get? (take n s) i = some (s i) := by
  induction n generalizing s i with
  | zero =>
      omega
  | succ n ih =>
      cases i with
      | zero =>
          simp [take, get?]
      | succ i =>
          simp [take, get?]
          exact ih (fun i => s (i + 1)) (by omega)

def agrees (p : Pref) (s : Nat → Bool) : Prop :=
  ∀ i, i < length p → get? p i = some (s i)

theorem agrees_nil (s : Nat → Bool) : agrees .nil s := by
  intro i hi
  simp [length] at hi

theorem agrees_take (n : Nat) (s : Nat → Bool) : agrees (take n s) s := by
  intro i hi
  rw [length_take] at hi
  exact get?_take s hi

theorem le_take_of_agrees {p : Pref} {s : Nat → Bool} (h : agrees p s) :
    le p (take (length p) s) := by
  apply le_of_get?
  intro i hi
  rw [h i hi, get?_take s hi]

structure Ideal where
  mem : Pref → Prop
  hasNil : mem .nil
  down : ∀ {p q : Pref}, mem p → le q p → mem q
  directed : ∀ {p q : Pref}, mem p → mem q → ∃ r, mem r ∧ le p r ∧ le q r

def finiteIdeal (p : Pref) : Ideal where
  mem q := le q p
  hasNil := le_nil p
  down := fun hp hq => le_trans hq hp
  directed := by
    intro q r hq hr
    cases le_total_of_common_bound hq hr with
    | inl hqr =>
        exact ⟨r, hr, hqr, le_refl r⟩
    | inr hrq =>
        exact ⟨q, hq, le_refl q, hrq⟩

theorem length_le_of_le {p q : Pref} (h : le p q) : length p ≤ length q := by
  induction p generalizing q with
  | nil =>
      simp [length]
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at h
      | cons c u =>
          rcases h with ⟨rfl, ht⟩
          simp [length]
          exact ih ht

def infiniteIdeal (s : Nat → Bool) : Ideal where
  mem q := agrees q s
  hasNil := agrees_nil s
  down := by
    intro p q hp hqp
    intro i hi
    have hlen : i < length p := Nat.lt_of_lt_of_le hi (length_le_of_le hqp)
    have := hp i hlen
    rw [← get?_le hqp hi] at this
    exact this
  directed := by
    intro p q hp hq
    let n := max (length p) (length q)
    refine ⟨take n s, agrees_take n s, ?_, ?_⟩
    · have hlen : length p ≤ n := Nat.le_max_left _ _
      have htake : le p (take (length p) s) := le_take_of_agrees hp
      have hmono : le (take (length p) s) (take n s) := by
        apply le_of_get?
        intro i hi
        rw [length_take] at hi
        rw [get?_take s hi, get?_take s (Nat.lt_of_lt_of_le hi hlen)]
      exact le_trans htake hmono
    · have hlen : length q ≤ n := Nat.le_max_right _ _
      have htake : le q (take (length q) s) := le_take_of_agrees hq
      have hmono : le (take (length q) s) (take n s) := by
        apply le_of_get?
        intro i hi
        rw [length_take] at hi
        rw [get?_take s hi, get?_take s (Nat.lt_of_lt_of_le hi hlen)]
      exact le_trans htake hmono

inductive Shade where
  | finite (p : Pref)
  | infinite (s : Nat → Bool)

def shadeMem : Shade → Pref → Prop
  | .finite p, q => le q p
  | .infinite s, q => agrees q s

def shadeIdeal : Shade → Ideal
  | .finite p => finiteIdeal p
  | .infinite s => infiniteIdeal s

theorem shadeIdeal_mem (a : Shade) (p : Pref) : (shadeIdeal a).mem p ↔ shadeMem a p := by
  cases a <;> rfl

def shadeLe (a b : Shade) : Prop :=
  ∀ p, shadeMem a p → shadeMem b p

theorem shadeLe_finite {p q : Pref} :
    shadeLe (.finite p) (.finite q) ↔ le p q := by
  constructor
  · intro h
    exact h p (le_refl p)
  · intro hpq r hr
    exact le_trans hr hpq

theorem shadeLe_finite_infinite {p : Pref} {s : Nat → Bool} :
    shadeLe (.finite p) (.infinite s) ↔ agrees p s := by
  constructor
  · intro h
    exact h p (le_refl p)
  · intro hp q hq
    intro i hi
    have hlen : i < length p := Nat.lt_of_lt_of_le hi (length_le_of_le hq)
    rw [get?_le hq hi]
    exact hp i hlen

theorem not_infinite_le_finite {s : Nat → Bool} {p : Pref} :
    ¬ shadeLe (.infinite s) (.finite p) := by
  intro h
  have hmem : shadeMem (.finite p) (take (length p + 1) s) :=
    h _ (agrees_take (length p + 1) s)
  have hlen := length_le_of_le hmem
  rw [length_take] at hlen
  omega

theorem shadeLe_infinite {s t : Nat → Bool} :
    shadeLe (.infinite s) (.infinite t) ↔ ∀ n, s n = t n := by
  constructor
  · intro h n
    have hmem : agrees (take (n + 1) s) t := h _ (agrees_take (n + 1) s)
    have hg := hmem n (by rw [length_take]; omega)
    have hs := get?_take s (by omega : n < n + 1)
    rw [hs] at hg
    exact Option.some.inj hg
  · intro h p hp i hi
    rw [hp i hi, h i]

theorem eq_of_le_of_length_eq {p q : Pref} (h : le p q) (hl : length p = length q) : p = q := by
  induction p generalizing q with
  | nil =>
      cases q with
      | nil => rfl
      | cons _ _ =>
          simp [length] at hl
  | cons b t ih =>
      cases q with
      | nil =>
          simp [le] at h
      | cons c u =>
          rcases h with ⟨rfl, ht⟩
          simp [length] at hl
          exact congrArg (Pref.cons b) (ih ht hl)

theorem exists_longest (I : Ideal) (hN : ∃ N, ∀ p, I.mem p → length p ≤ N) :
    ∃ p, I.mem p ∧ ∀ q, I.mem q → length q ≤ length p := by
  rcases hN with ⟨N, hN⟩
  induction N with
  | zero =>
      refine ⟨.nil, I.hasNil, ?_⟩
      intro q hq
      exact hN q hq
  | succ N ih =>
      by_cases h : ∃ p, I.mem p ∧ length p = N + 1
      · rcases h with ⟨p, hp, hlen⟩
        refine ⟨p, hp, ?_⟩
        intro q hq
        have hqN := hN q hq
        omega
      · apply ih
        intro p hp
        have hpN := hN p hp
        have hne : length p ≠ N + 1 := by
          intro heq
          exact h ⟨p, hp, heq⟩
        omega

theorem unbounded_of_not {I : Ideal}
    (h : ¬ ∃ N, ∀ p, I.mem p → length p ≤ N) :
    ∀ n, ∃ p, I.mem p ∧ n < length p := by
  intro n
  by_cases hex : ∃ p, I.mem p ∧ n < length p
  · exact hex
  · exfalso
    apply h
    refine ⟨n, ?_⟩
    intro p hp
    have hnot : ¬ n < length p := fun hlt => hex ⟨p, hp, hlt⟩
    omega

theorem get?_of_lt {p : Pref} {i : Nat} (hi : i < length p) : ∃ b, get? p i = some b := by
  induction p generalizing i with
  | nil =>
      simp [length] at hi
  | cons b t ih =>
      cases i with
      | zero =>
          exact ⟨b, rfl⟩
      | succ i =>
          simp [length] at hi
          simpa [get?] using ih hi

theorem get?_directed {I : Ideal} {p q : Pref} {i : Nat}
    (hp : I.mem p) (hq : I.mem q) (hip : i < length p) (hiq : i < length q) :
    get? p i = get? q i := by
  rcases I.directed hp hq with ⟨r, _, hpr, hqr⟩
  have hip' : i < length r := Nat.lt_of_lt_of_le hip (length_le_of_le hpr)
  rw [get?_le hpr hip, get?_le hqr hiq]

theorem bitIndexProof {I : Ideal}
    (h : ∀ n, ∃ p, I.mem p ∧ n < length p) (n : Nat) :
    n < length (Classical.choose (h (n + 1))) :=
  Nat.lt_trans (Nat.lt_succ_self n) (Classical.choose_spec (h (n + 1))).2

noncomputable def chosenBit (I : Ideal)
    (h : ∀ n, ∃ p, I.mem p ∧ n < length p) (n : Nat) : Bool :=
  Classical.choose (get?_of_lt (bitIndexProof h n))

theorem chosenBit_eq (I : Ideal)
    (h : ∀ n, ∃ p, I.mem p ∧ n < length p) (n : Nat) :
    get? (Classical.choose (h (n + 1))) n = some (chosenBit I h n) :=
  Classical.choose_spec (get?_of_lt (bitIndexProof h n))

noncomputable def shadeOfIdeal (I : Ideal) : Shade := by
  classical
  exact if h : ∃ N, ∀ p, I.mem p → length p ≤ N then
    .finite (Classical.choose (exists_longest I h))
  else
    .infinite (chosenBit I (unbounded_of_not h))

theorem shadeOfIdeal_mem (I : Ideal) (p : Pref) :
    shadeMem (shadeOfIdeal I) p ↔ I.mem p := by
  classical
  by_cases h : ∃ N, ∀ q, I.mem q → length q ≤ N
  · have hspec := Classical.choose_spec (exists_longest I h)
    have hdef : shadeOfIdeal I = .finite (Classical.choose (exists_longest I h)) := by
      simp [shadeOfIdeal, h]
    rw [hdef]
    constructor
    · intro hpq
      exact I.down hspec.1 hpq
    · intro hp
      rcases I.directed hp hspec.1 with ⟨r, hr, hpr, hrp⟩
      have hrlen := hspec.2 r hr
      have hlenp := length_le_of_le hrp
      have heq : length (Classical.choose (exists_longest I h)) = length r := by
        omega
      have hsame : Classical.choose (exists_longest I h) = r :=
        eq_of_le_of_length_eq hrp heq
      rw [← hsame] at hpr
      exact hpr
  · have hu := unbounded_of_not h
    have hdef : shadeOfIdeal I = .infinite (chosenBit I hu) := by
      simp [shadeOfIdeal, h]
    rw [hdef]
    constructor
    · intro hag
      -- p agrees with chosen bits, so p ≤ a chosen long rung
      let n := length p
      have hlong := Classical.choose_spec (hu (n + 1))
      have hle : le p (Classical.choose (hu (n + 1))) := by
        apply le_of_get?
        intro i hi
        have hb := hag i hi
        have hbit := chosenBit_eq I hu i
        have hiShort : i < length (Classical.choose (hu (i + 1))) :=
          Nat.lt_of_succ_lt (Classical.choose_spec (hu (i + 1))).2
        have hiLong : i < length (Classical.choose (hu (n + 1))) :=
          Nat.lt_trans (Nat.lt_succ_of_lt hi) hlong.2
        have hagree := get?_directed
          (Classical.choose_spec (hu (i + 1))).1
          hlong.1
          hiShort
          hiLong
        rw [hagree] at hbit
        rw [hb]
        exact hbit.symm
      exact I.down hlong.1 hle
    · intro hp i hi
      have hlong := Classical.choose_spec (hu (i + 1))
      have hiLong : i < length (Classical.choose (hu (i + 1))) :=
        Nat.lt_of_succ_lt hlong.2
      have hagree := get?_directed hp hlong.1 hi hiLong
      rw [hagree, chosenBit_eq I hu i]

/-! ### Scott topology -/

theorem shadeMem_nil (a : Shade) : shadeMem a .nil := by
  cases a with
  | finite p => exact le_nil p
  | infinite s => exact agrees_nil s

theorem shadeLe_refl (a : Shade) : shadeLe a a :=
  fun _ hp => hp

theorem shadeLe_trans {a b c : Shade} (hab : shadeLe a b) (hbc : shadeLe b c) :
    shadeLe a c :=
  fun p hp => hbc p (hab p hp)

/-- Rungs that appear in at least one shade of a directed family. -/
def familyIdeal (D : Shade → Prop) (hD : ∃ a, D a)
    (hdir : ∀ a b, D a → D b → ∃ c, D c ∧ shadeLe a c ∧ shadeLe b c) : Ideal where
  mem p := ∃ a, D a ∧ shadeMem a p
  hasNil := by
    rcases hD with ⟨a, ha⟩
    exact ⟨a, ha, shadeMem_nil a⟩
  down := by
    intro p q hp hqp
    rcases hp with ⟨a, ha, hpa⟩
    have hdown := (shadeIdeal a).down ((shadeIdeal_mem a p).2 hpa) hqp
    exact ⟨a, ha, (shadeIdeal_mem a q).1 hdown⟩
  directed := by
    intro p q hp hq
    rcases hp with ⟨a, ha, hpa⟩
    rcases hq with ⟨b, hb, hqb⟩
    rcases hdir a b ha hb with ⟨c, hc, hac, hbc⟩
    rcases (shadeIdeal c).directed
        ((shadeIdeal_mem c p).2 (hac p hpa))
        ((shadeIdeal_mem c q).2 (hbc q hqb)) with ⟨r, hr, hpr, hqr⟩
    exact ⟨r, ⟨c, hc, (shadeIdeal_mem c r).1 hr⟩, hpr, hqr⟩

noncomputable def shadeSup (D : Shade → Prop) (hD : ∃ a, D a)
    (hdir : ∀ a b, D a → D b → ∃ c, D c ∧ shadeLe a c ∧ shadeLe b c) : Shade :=
  shadeOfIdeal (familyIdeal D hD hdir)

theorem shadeSup_upper (D : Shade → Prop) (hD : ∃ a, D a)
    (hdir : ∀ a b, D a → D b → ∃ c, D c ∧ shadeLe a c ∧ shadeLe b c)
    {a : Shade} (ha : D a) : shadeLe a (shadeSup D hD hdir) := by
  intro p hp
  exact (shadeOfIdeal_mem (familyIdeal D hD hdir) p).2 ⟨a, ha, hp⟩

theorem shadeSup_least (D : Shade → Prop) (hD : ∃ a, D a)
    (hdir : ∀ a b, D a → D b → ∃ c, D c ∧ shadeLe a c ∧ shadeLe b c)
    {b : Shade} (hb : ∀ a, D a → shadeLe a b) :
    shadeLe (shadeSup D hD hdir) b := by
  intro p hp
  rcases (shadeOfIdeal_mem (familyIdeal D hD hdir) p).1 hp with ⟨a, ha, hpa⟩
  exact hb a ha p hpa

/-- Basic Scott-open set: shades that contain the finite rung `p`. -/
def above (p : Pref) (a : Shade) : Prop :=
  shadeMem a p

theorem above_upper {p : Pref} {a b : Shade} (ha : above p a) (hab : shadeLe a b) :
    above p b :=
  hab p ha

theorem above_inaccessible (D : Shade → Prop) (hD : ∃ a, D a)
    (hdir : ∀ a b, D a → D b → ∃ c, D c ∧ shadeLe a c ∧ shadeLe b c)
    (p : Pref) (hsup : above p (shadeSup D hD hdir)) :
    ∃ a, D a ∧ above p a :=
  (shadeOfIdeal_mem (familyIdeal D hD hdir) p).1 hsup

theorem above_nil (a : Shade) : above .nil a :=
  shadeMem_nil a

/-- Two basic opens meet in a basic open around each common point. -/
theorem above_basis {p q : Pref} {a : Shade} (hp : above p a) (hq : above q a) :
    ∃ r, above r a ∧ ∀ b, above r b → above p b ∧ above q b := by
  rcases (shadeIdeal a).directed ((shadeIdeal_mem a p).2 hp) ((shadeIdeal_mem a q).2 hq)
    with ⟨r, hr, hpr, hqr⟩
  refine ⟨r, (shadeIdeal_mem a r).1 hr, ?_⟩
  intro b hb
  exact ⟨
    (shadeIdeal_mem b p).1 ((shadeIdeal b).down ((shadeIdeal_mem b r).2 hb) hpr),
    (shadeIdeal_mem b q).1 ((shadeIdeal b).down ((shadeIdeal_mem b r).2 hb) hqr)⟩

end ResNova.Foundations.BinaryPrefixBasis

{
  "framework": "vite",
  "buildCommand": "node scripts/mount-observatory.mjs && pnpm exec vite build",
  "outputDirectory": "dist/public",
  "redirects": [
    { "source": "/observatory", "destination": "/observatory/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!assets/|observatory(?:/|$)).*)", "destination": "/index.html" }
  ]
}
